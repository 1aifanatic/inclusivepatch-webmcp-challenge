{
  "name": "inclusivepatch",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "A WebMCP accessibility remediation and journey verification studio.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:production": "node scripts/verify-production.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:e2e"
  },
  "dependencies": {
    "axe-core": "^4.10.3",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.8",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.32.0"
  },
  "packageManager": "pnpm@9.9.0"
}
